# ── تنظیمات اسکریپت سلامت‌سنجی حسابیار ──
# این فایل رو کپی کن به .env و مقدارهای واقعی رو جایگزین کن.
# .env هیچ‌وقت نباید commit بشه (روی گیت‌هاب/جای عمومی آپلود نشه) چون رمز واقعی توشه.

# ── آدرس‌ها (اجباری) ──
# آدرس بک‌اند دیپلوی‌شده (بدون / در انتها). مثال: https://api.hesabyar.example.com
API_BASE_URL=

# آدرس فرانت دیپلوی‌شده — پنل اصلی شرکت‌ها (بدون / در انتها). مثال: https://app.hesabyar.example.com
FRONTEND_BASE_URL=

# مسیر پنل سوپرادمین روی همون فرانت، معمولاً /admin.html
ADMIN_HTML_PATH=/admin.html

# ── کاربر تست شرکت (اجباری برای بخش «جریان کامل کاربر») ──
# پیشنهاد: یه شرکت تستی جدا بساز (نه شرکت واقعی مشتری) که اسکریپت باهاش کار می‌کنه.
# اگه خالی بذاری، اسکریپت خودش با ثبت‌نام یه شرکت تستی جدید می‌سازه (نیاز به دسترسی POST /api/auth/register داره).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ── سوپرادمین (اختیاری — اگه خالی باشه، تست‌های بخش سوپرادمین رد می‌شن نه فیل) ──
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# دقیقاً همون مقداری که در .env بک‌اند به‌عنوان ADMIN_ROUTE_SECRET گذاشتی
ADMIN_ROUTE_SECRET=

# ── تنظیمات اجرا (اختیاری) ──
# اگه true باشه، شرکت/دیتای تستی که اسکریپت ساخته رو در پایان پاک نمی‌کنه (برای بررسی دستی بعدی)
KEEP_TEST_DATA=false

# تعداد میلی‌ثانیه فاصله بین درخواست‌ها (برای رد نشدن از rate limit واقعی سرور دیپلوی‌شده)
REQUEST_DELAY_MS=150
