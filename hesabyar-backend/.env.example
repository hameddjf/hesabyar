# پورت سرور (اکثر هاست‌های رایگان خودشون از طریق process.env.PORT ست میکنن)
PORT=4000

# مسیر فایل دیتابیس SQLite حسابیار (روی هاست رایگان حتما روی یک دیسک persistent باشه)
DB_PATH=./data/hesabyar.sqlite

# رمز امضای JWT — حتما در محیط production عوض بشه
JWT_SECRET=change-this-secret-in-production

# ── سوپرادمین (پنل مدیریت همه‌ی شرکت‌ها) ──
# سکرت JWT کاملاً جدا از JWT_SECRET بالا — حتما یک مقدار متفاوت و طولانی بذار
ADMIN_JWT_SECRET=change-this-to-a-different-long-random-secret

# پیشوند مسیر API سوپرادمین — به‌جای چیزی قابل‌حدس مثل "admin"،
# یک رشته‌ی تصادفی طولانی بذار (مثلاً با: openssl rand -hex 16)
# و هرگز جایی پابلیک منتشرش نکن. نمونه: ADMIN_ROUTE_SECRET=x7f2a9b1c4d8e3f6
ADMIN_ROUTE_SECRET=CHANGE-THIS-TO-A-RANDOM-UNGUESSABLE-STRING

# فقط برای اجرای یک‌بار npm run seed (ساخت اولین سوپرادمین) — بعدش از .env پاک کن
SEED_ADMIN_EMAIL=superadmin@hesabyar.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# آدرس فرانت برای CORS (چند مورد رو با کاما جدا کن)
CORS_ORIGIN=http://localhost:5173

# ── تنظیمات پیش‌فرض اتصال به هلو (SQL Server) ──
# این‌ها فقط default هستن؛ هر شرکت می‌تونه از طریق فرم اتصال در صفحه‌ی «یکپارچه‌سازی هلو» خودش این مقادیر رو وارد کنه.
# نکته‌ی مهم: صرفاً داشتن فایل بکاپ (.bak) کافی نیست — باید ابتدا روی یک نمونه‌ی
# در حال اجرای SQL Server (مثلاً SQL Server Express، رایگانه) Restore بشه، و بعد آدرس/پورت
# همون نمونه‌ی در حال اجرا (نه فایل بکاپ) اینجا وارد بشه.
HOLO_DEFAULT_HOST=127.0.0.1
HOLO_DEFAULT_PORT=1433
HOLO_DEFAULT_USER=sa
HOLO_DEFAULT_PASSWORD=

# آدرس فرانت (برای ساختن لینک بازنشانی رمز عبور که توی ایمیل فرستاده می‌شه)
FRONTEND_URL=http://localhost:5173

# ── تنظیمات SMTP برای ارسال ایمیل واقعی (فراموشی رمز عبور و ...) ──
# اگه این‌ها رو خالی بذاری، به‌جای ارسال واقعی ایمیل، محتوای ایمیل و لینک
# توی کنسول سرور چاپ می‌شه (مناسب توسعه/تست بدون نیاز به SMTP واقعی).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="حسابیار <no-reply@example.com>"
